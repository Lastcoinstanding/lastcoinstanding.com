                    <!-- Primary Inputs -->
                    <div class="calc-grid">
                        <div class="calc-field">
                            <label>Home Price Today<span class="help-tip" tabindex="0">?<span class="tip-content">The default, $415,000, is the 2025 median price of <strong>new</strong> houses sold in the US (Census/HUD, FRED <em>MSPUS</em>), rounded. Enter your own.</span></span></label>
