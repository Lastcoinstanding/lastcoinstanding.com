<svg viewBox="0 0 80 60" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <!-- The page's own subject: two complete plans that start from the same
       question and separate. Deliberately NOT good-vs-bad colouring — the two
       curves carry the page's Plan A amber and Plan B slate, the same pair the
       chart uses, because neither column is the winner. The bracket at the
       right is the difference the page exists to state. -->
  <line x1="8" y1="52" x2="72" y2="52" stroke="#e09422" stroke-width="1" opacity="0.25"/>
  <!-- Plan A -->
  <polyline points="10,34 24,32 38,28 52,21 62,14" stroke="#e09422" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  <!-- Plan B — same origin, a different choice -->
  <polyline points="10,34 24,35 38,36 52,34 62,29" stroke="#6db3d4" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  <!-- the shared starting point -->
  <circle cx="10" cy="34" r="2" fill="#f2eee8"/>
  <!-- the delta bracket: what the difference buys -->
  <path d="M68 14 L71 14 L71 29 L68 29" stroke="#f2eee8" stroke-width="1" fill="none" opacity="0.7" stroke-linecap="round" stroke-linejoin="round"/>
  <circle cx="62" cy="14" r="1.8" fill="#e09422"/>
  <circle cx="62" cy="29" r="1.8" fill="#6db3d4"/>
</svg>
