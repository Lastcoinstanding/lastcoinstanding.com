<svg viewBox="0 0 80 60" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <!-- The hub's own subject: four questions in order, not four calculators in a
       pile. Four steps rising left to right, the last one carrying the crash
       notch — the question that comes after the plan is chosen. The connecting
       line is the plan travelling between them. -->
  <line x1="8" y1="52" x2="72" y2="52" stroke="#e09422" stroke-width="1" opacity="0.25"/>
  <line x1="12" y1="42" x2="66" y2="18" stroke="#6a6256" stroke-width="1" stroke-dasharray="2 2.5" opacity="0.7"/>
  <rect x="8"  y="40" width="11" height="10" rx="1.6" fill="none" stroke="#e09422" stroke-width="1.5"/>
  <rect x="25" y="34" width="11" height="16" rx="1.6" fill="none" stroke="#e09422" stroke-width="1.5"/>
  <rect x="42" y="26" width="11" height="24" rx="1.6" fill="none" stroke="#e09422" stroke-width="1.5"/>
  <rect x="59" y="16" width="11" height="34" rx="1.6" fill="none" stroke="#6db3d4" stroke-width="1.5"/>
  <!-- the crash notch on the fourth step -->
  <polyline points="60,26 62.5,33 65,27 67.5,31 69,28" stroke="#c0603a" stroke-width="1.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  <circle cx="13.5" cy="40" r="1.9" fill="#f2eee8"/>
</svg>
