<svg viewBox="0 0 80 60" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <!-- The floor as the page reads it: a solid lower line the price rides along and
       touches but does not go through, under a much more volatile upper edge. The
       asymmetry IS the finding, so the two edges are drawn deliberately unlike each
       other — the floor heavy and straight, the ceiling faint and dashed. -->
  <line x1="6" y1="12" x2="74" y2="6" stroke="#d9b36b" stroke-width="1" stroke-dasharray="1 5" opacity="0.55"/>
  <line x1="6" y1="30" x2="74" y2="22" stroke="#e09422" stroke-width="1.1" opacity="0.5"/>
  <line x1="6" y1="47" x2="74" y2="39" stroke="#c0603a" stroke-width="2.2" stroke-linecap="round"/>
  <polyline points="6,44 14,33 20,45 27,20 34,43 41,14 48,40 55,25 62,37 68,17 74,36"
            stroke="#6db3d4" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  <!-- the three touches: where the price line comes down onto the floor -->
  <circle cx="14" cy="33" r="1.6" fill="#F7931A"/>
  <circle cx="34" cy="43" r="1.6" fill="#F7931A"/>
  <circle cx="62" cy="37" r="1.6" fill="#F7931A"/>
</svg>
