<svg viewBox="0 0 80 60" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block">
  <!-- The Power Law channel — floor, trend, upper band — with a live marker for "where we are". -->
  <line x1="8" y1="52" x2="74" y2="52" stroke="#2a2a2a" stroke-width="1"/>
  <line x1="8" y1="52" x2="8" y2="8" stroke="#2a2a2a" stroke-width="1"/>
  <!-- upper band -->
  <path d="M 8 40 L 74 10" stroke="#d4a843" stroke-width="1.6" fill="none" stroke-linecap="round" opacity="0.7"/>
  <!-- trend -->
  <path d="M 8 46 L 74 20" stroke="#e09422" stroke-width="2" fill="none" stroke-linecap="round"/>
  <!-- floor -->
  <path d="M 8 50 L 74 30" stroke="#c0392b" stroke-width="1.6" fill="none" stroke-linecap="round" opacity="0.6"/>
  <!-- today's marker, sitting low in the channel (near the floor) -->
  <circle cx="52" cy="35" r="3.4" fill="none" stroke="#e09422" stroke-width="1" opacity="0.5"/>
  <circle cx="52" cy="35" r="2.2" fill="#F7931A" stroke="#e8e0d4" stroke-width="0.8"/>
</svg>
