    {% for g in lenders.groups %}
    <section class="ln-group" id="{{ g.id }}" data-group="{{ g.id }}">
        <h2 class="ln-grp">{{ g.title }}</h2>
        <p class="ln-grp-sub">{% if g.qualifier %}<span class="ln-tag qual">{{ g.qualifier }}</span> {% endif %}{{ g.sub | replace('Borrowing Against Your Stack → mortgages', '<a href="/bitcoin-backed-mortgages">Bitcoin-Backed Mortgages</a>') | safe }}</p>
        <div class="ln-grid">
        {% for l in lenders.lenders %}{% if l.group == g.id %}
            {% set ltv = l.ltv %}
            <article class="ln-card" id="lender-{{ l.id }}" data-id="{{ l.id }}"
                     data-open="{{ ltv.open if ltv.open !== null and ltv.open !== undefined else '' }}"
                     data-ref="{{ ltv.reference if ltv.reference else '' }}"
                     data-call="{{ ltv.call if ltv.call !== null and ltv.call !== undefined else '' }}"
                     data-liq="{{ ltv.liq if ltv.liq !== null and ltv.liq !== undefined else '' }}"
                     data-bitcoin-only="{{ 'y' if l.filters.bitcoinOnly else 'n' }}"
                     data-no-rehyp="{{ 'y' if l.filters.noRehyp else 'n' }}"
                     data-hold-key="{{ 'y' if l.filters.holdKey else 'n' }}"
                     data-no-price-liq="{{ 'y' if l.filters.noPriceLiq else 'n' }}"
                     data-under5k="{{ 'y' if l.filters.under5k else 'n' }}"
                     data-states-type="{{ l.states.type }}"
                     data-states-list="{{ (l.states.list | join(',')) if l.states.list else '' }}"
