<section class="hero">
  <h1>Compare <em>Retirement Plans</em></h1>
  <div class="hero-subtitle">Every plan is a choice against the plan you didn&rsquo;t pick.</div>
  <p class="subtitle">Retire this year or next, draw more or less, wait for a bigger stack. Set both plans side by side and read what the difference actually buys.</p>
</section>

<main class="content-area">

  {% include 'components/tool-framing.njk' %}

  <!-- ════════ THE TWO PLANS (design §2, §3) ════════
       Three inputs per column — the things a reader controls — and one
       shared assumptions card governing both. Per-column assumptions are
       refused by design (§2, the confounding argument): if column B could
       carry a different world, every verdict row below would silently
       become a model-vs-model claim.

       Mobile (375px): the columns stack under a sticky A/B switcher that
       chooses which plan is being EDITED. Both plans stay on the chart. -->
  <section class="crp-section" id="plans" aria-label="The two plans">

    <div class="crp-switcher" id="crpSwitcher" role="group" aria-label="Which plan to edit">
      <span class="crp-switcher-label">Editing</span>
      <div class="seg-control seg-2">
        <button type="button" class="seg-btn is-active" data-editcol="a">Plan A</button>
        <button type="button" class="seg-btn" data-editcol="b">Plan B</button>
      </div>
    </div>

    <div class="crp-columns">

      <div class="crp-col" data-col="a" id="crpColA">
        <div class="crp-col-head">
          <span class="crp-col-tag crp-tag-a">Plan A</span>
        </div>
        <div class="crp-inputs">
          <div class="crp-field">
            <label class="crp-field-label" for="crpA_retire">Retire in</label>
            <div class="crp-stepper" data-col="a" data-key="retirementYear">
              <button type="button" class="crp-step-btn" data-dir="-1" aria-label="Plan A, retire one year earlier">&#9664;</button>
              <button type="button" class="crp-stepper-value" id="crpA_retire" data-role="value" aria-label="Plan A retirement year">&mdash;</button>
              <button type="button" class="crp-step-btn" data-dir="1" aria-label="Plan A, retire one year later">&#9654;</button>
            </div>
          </div>
          <div class="crp-field">
            <label class="crp-field-label" for="crpA_stack">Stack at retirement</label>
            <div class="crp-stepper" data-col="a" data-key="btcStack">
              <button type="button" class="crp-step-btn" data-dir="-1" aria-label="Plan A, smaller stack">&#9664;</button>
              <button type="button" class="crp-stepper-value" id="crpA_stack" data-role="value" aria-label="Plan A stack in bitcoin">&mdash;</button>
              <button type="button" class="crp-step-btn" data-dir="1" aria-label="Plan A, larger stack">&#9654;</button>
            </div>
          </div>
          <div class="crp-field">
            <label class="crp-field-label" for="crpA_income">Annual withdrawal</label>
            <div class="crp-stepper" data-col="a" data-key="targetIncomeUSD">
              <button type="button" class="crp-step-btn" data-dir="-1" aria-label="Plan A, draw less">&#9664;</button>
              <button type="button" class="crp-stepper-value" id="crpA_income" data-role="value" aria-label="Plan A annual withdrawal">&mdash;</button>
              <button type="button" class="crp-step-btn" data-dir="1" aria-label="Plan A, draw more">&#9654;</button>
            </div>
          </div>
        </div>
        <p class="crp-col-verdict" id="crpVerdictA">&mdash;</p>
      </div>

      <div class="crp-col" data-col="b" id="crpColB">
        <div class="crp-col-head">
          <span class="crp-col-tag crp-tag-b">Plan B</span>
          <button type="button" class="crp-copy-btn" id="crpCopyAtoB" title="Copy Plan A into Plan B">Match Plan A</button>
        </div>
        <div class="crp-inputs">
          <div class="crp-field">
            <label class="crp-field-label" for="crpB_retire">Retire in</label>
            <div class="crp-stepper" data-col="b" data-key="retirementYear">
              <button type="button" class="crp-step-btn" data-dir="-1" aria-label="Plan B, retire one year earlier">&#9664;</button>
              <button type="button" class="crp-stepper-value" id="crpB_retire" data-role="value" aria-label="Plan B retirement year">&mdash;</button>
              <button type="button" class="crp-step-btn" data-dir="1" aria-label="Plan B, retire one year later">&#9654;</button>
            </div>
          </div>
          <div class="crp-field">
            <label class="crp-field-label" for="crpB_stack">Stack at retirement</label>
            <div class="crp-stepper" data-col="b" data-key="btcStack">
              <button type="button" class="crp-step-btn" data-dir="-1" aria-label="Plan B, smaller stack">&#9664;</button>
              <button type="button" class="crp-stepper-value" id="crpB_stack" data-role="value" aria-label="Plan B stack in bitcoin">&mdash;</button>
              <button type="button" class="crp-step-btn" data-dir="1" aria-label="Plan B, larger stack">&#9654;</button>
            </div>
          </div>
          <div class="crp-field">
            <label class="crp-field-label" for="crpB_income">Annual withdrawal</label>
            <div class="crp-stepper" data-col="b" data-key="targetIncomeUSD">
              <button type="button" class="crp-step-btn" data-dir="-1" aria-label="Plan B, draw less">&#9664;</button>
              <button type="button" class="crp-stepper-value" id="crpB_income" data-role="value" aria-label="Plan B annual withdrawal">&mdash;</button>
              <button type="button" class="crp-step-btn" data-dir="1" aria-label="Plan B, draw more">&#9654;</button>
            </div>
          </div>
        </div>
        <p class="crp-col-verdict" id="crpVerdictB">&mdash;</p>
      </div>

    </div>

    <!-- ════════ SHARED ASSUMPTIONS (design §3) ════════
         One card, governing both columns. The bear toggle is the page's
         only environment control and it is deliberately not per-column. -->
    <div class="crp-shared">
      <div class="crp-shared-head">
        <span class="crp-shared-tag">Both plans</span>
        <span class="crp-shared-summary" id="crpSharedSummary">&mdash;</span>
      </div>
      <div class="crp-shared-row">
        <label class="crp-bear">
          <input type="checkbox" id="crpBearToggle">
          <span class="crp-bear-text">Test both plans against a bear market at retirement</span>
        </label>
        <p class="crp-note crp-bear-note">The crash always hits both plans, so the comparison stays about the choice, not the luck. It lands in the first year of <em>each</em> plan&rsquo;s own retirement, using the <a href="/the-bitcoin-retirement-stress-test">Retirement Stress Test</a>&rsquo;s crash definition &mdash; <span id="crpBearSpec">&mdash;</span> &mdash; not a second one. The question it answers: does your option&rsquo;s advantage grow or shrink when the market turns hostile?</p>
      </div>
      <p class="crp-note crp-shared-foot">Growth path, inflation and horizon are shared and cannot be set per column &mdash; if one plan could carry a friendlier world, every row below would be a model comparison rather than a plan comparison. <a href="/the-bitcoin-retirement">The flagship</a> holds the bands, the 60/40 foil and the gap-persists variant this page leaves out. <button type="button" class="crp-reset" id="crpReset">Reset both plans</button></p>
    </div>

  </section>

  <!-- ════════ HERO CHART (design §5, Option 1 — paired balance curves) ════════
       One job: which line holds. No bands, no 60/40, no per-bitcoin lines —
       the flagship already owns full model context, which is what earns this
       chart its simplicity. Hovering a column or a legend entry emphasises
       that plan and dims the other; there is no A/B toggle, because
       comparison requires simultaneity. -->
  <section class="crp-section" id="chart" aria-label="Both plans over time">
    <p class="crp-eyebrow">Both plans, one axis</p>
    <h2 class="crp-h2">What each plan is worth, year by year</h2>
    <p class="crp-lead" id="crpChartLead">&mdash;</p>
    <div class="crp-chart-wrap">
      <canvas id="crpChart" height="380" aria-label="Stack value over time for Plan A and Plan B"></canvas>
    </div>
    <p class="crp-note" id="crpChartCaption">&mdash;</p>
  </section>

  <!-- ════════ DELTA STRIP (design §7) ════════
       The page's payload, promoted above the table per the §9 ruling. Two
       or three plain sentences: the screenshot-and-share unit. -->
  <section class="crp-section" id="delta" aria-label="The difference">
    <div class="crp-delta">
      <div class="crp-delta-tag">The difference</div>
      <ul class="crp-delta-list" id="crpDeltaList"></ul>
    </div>
  </section>

  <!-- ════════ VERDICT TABLE (design §7) ════════
       A | B | Δ. The Δ column is sentences, not arithmetic: two columns of
       numbers make the reader do the subtraction, and the subtraction is
       not the insight. Vocabulary is aligned to Escape Velocity so the
       family reads as one system. -->
  <section class="crp-section" id="verdict" aria-label="Verdict table">
    <p class="crp-eyebrow">Row by row</p>
    <h2 class="crp-h2">Where the two plans differ</h2>
    <div class="crp-scroll">
      <table class="crp-table" id="crpVerdictTable">
        <thead>
          <tr>
            <th scope="col">&nbsp;</th>
            <th scope="col"><span class="crp-th-a">A</span><span class="crp-th-full"> &middot; Plan A</span></th>
            <th scope="col"><span class="crp-th-b">B</span><span class="crp-th-full"> &middot; Plan B</span></th>
            <th scope="col">&Delta;</th>
          </tr>
        </thead>
        <tbody id="crpVerdictRows"><!-- JS-populated --></tbody>
      </table>
    </div>
    <p class="crp-note">Every figure is a projection under the Power Law growth model &mdash; a description of bitcoin&rsquo;s historical trend, not a promise about its future. <a href="/the-power-law">The model and its limits</a> sit one click away, and its implied growth rate declines with time, which is why the same one-year difference does not buy the same thing at every retirement date.</p>
  </section>

  <!-- ════════ VERIFY THE MATH (design §4.6) ════════
       The flagship's audit renderer, one collapsible per column, same
       reproduce-any-row identity. -->
  <section class="crp-section" id="verify" aria-label="Verify the math">
    <p class="crp-eyebrow">The arithmetic</p>
    <h2 class="crp-h2">Verify the math</h2>
    <p class="crp-lead">Reproduce any row: <strong>Starting BTC &minus; BTC sold = BTC left</strong>; <strong>price &times; BTC left = stack value</strong>; <strong>income &divide; price = BTC sold</strong>. Same projection that draws everything above, one table per plan.</p>

    <div class="rt-accordion-item">
      <button type="button" class="rt-toggle" id="crpVerifyToggleA" aria-expanded="false" aria-controls="crpVerifyBodyA">
        <span class="rt-caret" aria-hidden="true">&#9656;</span> Verify the math &mdash; Plan A
      </button>
      <div class="rt-body" id="crpVerifyBodyA" hidden>
        <p class="rt-scenario-summary" id="crpVerifySummaryA"></p>
        <div class="rt-scroll">
          <table class="rt-table rt-verify-table">
            <thead>
              <tr><th>Year</th><th>Phase</th><th class="rt-num">BTC price</th><th class="rt-num">Starting BTC</th><th class="rt-num">Stack value</th><th class="rt-num">Income drawn</th><th class="rt-num">BTC sold</th><th class="rt-num">BTC left</th></tr>
            </thead>
            <tbody id="crpVerifyRowsA"></tbody>
          </table>
        </div>
        <p class="rt-note"><a href="/the-bitcoin-retirement" id="crpFlagshipLinkA">Open Plan A in the full retirement calculator &rarr;</a></p>
      </div>
    </div>

    <div class="rt-accordion-item">
      <button type="button" class="rt-toggle" id="crpVerifyToggleB" aria-expanded="false" aria-controls="crpVerifyBodyB">
        <span class="rt-caret" aria-hidden="true">&#9656;</span> Verify the math &mdash; Plan B
      </button>
      <div class="rt-body" id="crpVerifyBodyB" hidden>
        <p class="rt-scenario-summary" id="crpVerifySummaryB"></p>
        <div class="rt-scroll">
          <table class="rt-table rt-verify-table">
            <thead>
              <tr><th>Year</th><th>Phase</th><th class="rt-num">BTC price</th><th class="rt-num">Starting BTC</th><th class="rt-num">Stack value</th><th class="rt-num">Income drawn</th><th class="rt-num">BTC sold</th><th class="rt-num">BTC left</th></tr>
            </thead>
            <tbody id="crpVerifyRowsB"></tbody>
          </table>
        </div>
        <p class="rt-note"><a href="/the-bitcoin-retirement" id="crpFlagshipLinkB">Open Plan B in the full retirement calculator &rarr;</a></p>
      </div>
    </div>
  </section>

