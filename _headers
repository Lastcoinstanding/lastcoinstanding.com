# Unlisted outreach demos — keep them out of every index.
# X-Robots-Tag rather than a robots.txt Disallow on purpose: Disallow stops a
# crawler fetching the page, which also stops it seeing any noindex directive,
# and URL-only indexing can still happen. The header is served with the file,
# so a crawler that reaches the link must read the directive to have read the
# page at all. robots.txt is deliberately left as Allow: / .
/demo/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

# QA harnesses loaded only with ?qa (real-estate pair: rePairQA). Not content.
/qa/*
  X-Robots-Tag: noindex, nofollow

# Lightning Address JSON endpoint — set Content-Type and allow CORS
/.well-known/lnurlp/tips
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

# Self-hosted web fonts (2026-10-29). Each filename carries the upstream font
# version, so a file at a given URL never changes: cache it for a year. A new
# font version gets a new filename (see src/_includes/components/web-fonts.njk).
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Self-hosted libraries (2026-10-29): versioned filenames, so immutable.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
